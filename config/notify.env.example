# Copy to config/notify.env (chmod 600, gitignored) and fill in the real values.
# scripts/run_hk_monitor.sh sources this file with `set -a`, so anything here is
# exported to the monitor process.
#
# 信号频道：机会信号、新代币发现。
ARB_FEISHU_WEBHOOK=
#
# 报警频道（2026-09-16 起与信号频道分开）：人工审核、自动执行停机、
# gas 赞助失效、孤儿挂单。请用**另一个**群机器人的 webhook。
# 留空时报警会回退到信号频道，并在投递结果里标记 fell_back_to_signal。
ARB_FEISHU_ALERT_WEBHOOK=
